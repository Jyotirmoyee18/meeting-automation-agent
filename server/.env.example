# VoxNote AI — Server Environment Variables
# Copy this to .env and fill in real values

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# Allowed frontend origin (for CORS)
CLIENT_URL=http://localhost:3000

# ─── Database ─────────────────────────────────────────────────────────────────
# SQLite file path (relative to server directory)
DATABASE_PATH=./data/voxnote.db

# ─── Deepgram ─────────────────────────────────────────────────────────────────
# Get your key at https://console.deepgram.com
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# ─── Google Gemini ────────────────────────────────────────────────────────────
# Get your key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AQ.Ab8RN6JVzuDfxL_y0kDqT5v1fiT4Xrc9z1H9kQhsqcSQwEQXpw

# Gemini model to use (default: gemini-2.0-flash)
GEMINI_MODEL=gemini-2.0-flash
